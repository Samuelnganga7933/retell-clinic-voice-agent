# Retell API key - must be the one with the "webhook" badge in the dashboard
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxx
CLINIC_TZ=America/Los_Angeles
# Incident switch for step 5: none | slow | error | tz_bug
FAIL_MODE=none
# Verify signatures on custom function calls too (set false only to debug)
VERIFY_FUNCTIONS=true
DB_PATH=clinic.db
