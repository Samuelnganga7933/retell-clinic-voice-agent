# Retell API key. Use the key that shows the "webhook" badge in the dashboard.
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxx

# Bearer token for /calls, /calls/{id} and /functions (transcripts and patient names).
# Unset means those routes return 503.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

CLINIC_TZ=America/Los_Angeles

# Verify signatures on custom function calls as well as webhooks.
VERIFY_FUNCTIONS=true

# Seconds a booking may take before it is refused instead of committed. 0 disables the check.
FUNCTION_DEADLINE_S=5

# Incident drills: none | slow | error | tz_bug
FAIL_MODE=none
# How long FAIL_MODE=slow stalls each function call, in seconds
SLOW_SECONDS=12

DB_PATH=clinic.db
